# Copy this file to .env and fill in your key. Get a key at https://console.anthropic.com/settings/keys
# Note: this runs as its own standalone process, separate from any Claude Code session — it
# cannot use Claude Code's own credentials, so a real API key is required here regardless of
# whether you launch the bot from inside or outside Claude Code.
ANTHROPIC_API_KEY=

# Directory where the persistent Chrome profile (login session, cookies) is kept.
# Must live outside the project folder — it's real browser data, not project source.
# Defaults to ~/.openclaw/workspace/.playwright-profile if unset.
CHROME_PROFILE_DIR=

# Path to the JSON application log/dedup store. Defaults to
# ~/.openclaw/workspace/applications/application-log.json if unset.
APPLICATION_LOG_PATH=

# --- Job search ---
# Comma-separated list of LinkedIn search queries to rotate through.
SEARCH_QUERIES=Senior Software Engineer,Senior Backend Engineer,Senior Full Stack Developer
# LinkedIn location filter (e.g. "United States", "Canada", "Remote").
SEARCH_LOCATION=United States
# LinkedIn "date posted" filter: "day" (past 24 hours), "week" (past week), "month" (past month).
SEARCH_TIME_RANGE=week
# Comma-separated list of company names to never apply to (case-insensitive).
BANNED_COMPANIES=

# --- Form-fill defaults ---
# Postal/zip code used to fill address fields.
POSTAL_CODE=
# Expected salary figure used to fill compensation fields.
SALARY_EXPECTATION=
# Set to "false" to skip sending LinkedIn connection requests to the hiring team after a
# successful application submission.
AUTO_CONNECT_HIRING_TEAM=true

# --- AI answer persona (used in the system prompt's placeholders) ---
CANDIDATE_NAME=
CANDIDATE_TITLE=
CANDIDATE_LOCATION=
WORK_AUTHORIZATION=
YEARS_EXPERIENCE=
NOTICE_PERIOD_DAYS=14
SALARY_RANGE=

# --- Resume & system prompt content ---
# Recommended: leave these two unset and instead copy data/resume.example.txt -> data/resume.txt
# and data/system_prompt.example.txt -> data/system_prompt.txt, then fill those in (both are
# gitignored). That keeps this file free of personal data / long text blocks.
#
# Alternatively (e.g. an OpenClaw settings textarea with no file access), paste the text directly
# here. If used, wrap the value in double quotes so python-dotenv parses the embedded newlines
# correctly, e.g. RESUME_TEXT="line one\nline two". Resolution order: env var > local file >
# bundled example.
RESUME_TEXT=
SYSTEM_PROMPT_TEXT=
